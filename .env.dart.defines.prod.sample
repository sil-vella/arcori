# Copy to .env.dart.defines.prod — Flutter dart-define SSOT (production / VPS builds)
# Loaded by wfrun when you run automation/frontend/* with environment "prod".

ARCORI_API_REST_URL=https://api.your-domain.example
ARCORI_API_WS_URL=wss://api.your-domain.example/ws/authuser
ARCORI_DART_WS_URL=wss://game.your-domain.example/ws/authuser

FLUTTER_WEB_PORT=3002
FLUTTER_WEB_HOSTNAME=localhost

APP_PLATFORM=flutter
BUILD_MODE=release
SHOW_INTRO_LOTTIE=0
# Bumped by automation/frontend/build_appbundle.sh; used for flutter --build-name
APP_VERSION=1.0.0

# Firebase GA4 — enable for store builds with real keys from Firebase Console.
FIREBASE_SWITCH=true
FIREBASE_APP_ENVIRONMENT=production

FIREBASE_ANDROID_API_KEY=REPLACE_WITH_YOUR_ANDROID_API_KEY
FIREBASE_ANDROID_APP_ID=REPLACE_WITH_YOUR_ANDROID_APP_ID
FIREBASE_ANDROID_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_SENDER_ID
FIREBASE_ANDROID_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
FIREBASE_ANDROID_STORAGE_BUCKET=REPLACE_WITH_YOUR_STORAGE_BUCKET

FIREBASE_IOS_API_KEY=REPLACE_WITH_YOUR_IOS_API_KEY
FIREBASE_IOS_APP_ID=REPLACE_WITH_YOUR_IOS_APP_ID
FIREBASE_IOS_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_SENDER_ID
FIREBASE_IOS_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
FIREBASE_IOS_STORAGE_BUCKET=REPLACE_WITH_YOUR_STORAGE_BUCKET
FIREBASE_IOS_BUNDLE_ID=com.reignofplay.arcori
