flowchart TD
  title["Match setting — Play hub + live match SSOT"]

  subgraph entry["Entry"]
    Drawer["Drawer Play"]
    Path["AppPaths.play /play"]
    Screen["PlayScreen"]
    Drawer --> Path --> Screen
  end

  subgraph hub["Play hub — stays on route"]
    Idle["phase idle"]
    PlayBtn["Press Play"]
    Screen --> Idle
    Idle -->|"startPlay"| Selecting
  end

  subgraph select["Type selection"]
    Selecting["phase selectingType"]
    Modal["showMatchTypeSelectModal<br/>AppModal centered"]
    Types["practice / quickStart<br/>specialEvent / invite"]
    Cancel["cancelSelection"]
    Selecting --> Modal --> Types
    Modal -->|"dismiss null"| Cancel --> Idle
  end

  subgraph pipeline["MatchFlowNotifier pipeline"]
    Setup["phase typeSetup<br/>_runTypeSetup stub"]
    Match["phase inMatch<br/>_runMatchSsot"]
    Post["phase postMatch<br/>_runPostMatch stub"]
    Types -->|"selectType"| Setup --> Match --> Post --> Idle
  end

  subgraph dart["Dart match hot state"]
    Create["match/create<br/>catalog freeze"]
    Snap["MatchStore full snapshot"]
    EndCh["match/end"]
    Leave["match/leave"]
    Broadcast["match/state broadcast"]
    Create --> Snap --> Broadcast
    EndCh --> Snap
    Leave --> Snap
  end

  Match -->|"WS authuser when configured"| Create
  Match -->|"wait phase ended"| EndCh
  Match --> Leave
