# Copy to .env.local — local development (never commit .env.local)

ARCORI_ENV=local
ARCORI_ALLOW_DEV_LOGIN=true
APP_DEBUG=0
DUTCH_DEV_LOG=1

JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=604800
SERVICE_KEY=dev-service-key-change-me

POSTGRES_USER=arcori
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=arcori
# RBAC off by default locally — app user matches owner until PG_RBAC_ENABLED=1
PG_RBAC_ENABLED=0
POSTGRES_APP_USER=arcori
POSTGRES_APP_PASSWORD=devpassword
POSTGRES_READONLY_USER=arcori_readonly
POSTGRES_READONLY_PASSWORD=devpassword-readonly
DATABASE_URL=postgresql://arcori:devpassword@127.0.0.1:5433/arcori
MIGRATION_DATABASE_URL=postgresql://arcori:devpassword@127.0.0.1:5433/arcori
READONLY_DATABASE_URL=postgresql://arcori_readonly:devpassword-readonly@127.0.0.1:5433/arcori

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3002,http://localhost:3002

ARCORI_REDIS_READ_CACHE_ENABLED=false
ARCORI_REDIS_KEY_PREFIX=Arcori:cache:
ARCORI_CACHE_EXAMPLE_TTL=60
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

ARCORI_PRESENCE_ENABLED=true
ARCORI_PRESENCE_SESSION_TTL_SECONDS=90
ARCORI_PRESENCE_KEY_PREFIX=Arcori:presence:

ARCORI_RATE_LIMIT_ENABLED=true
ARCORI_RATE_LIMIT_KEY_PREFIX=Arcori:ratelimit:
ARCORI_RATE_LIMIT_GLOBAL_MAX=120
ARCORI_RATE_LIMIT_GLOBAL_WINDOW_S=60
ARCORI_RATE_LIMIT_AUTH_MAX=20
ARCORI_RATE_LIMIT_AUTH_WINDOW_S=60
ARCORI_RATE_LIMIT_AUTH_IDENTITY_MAX=10
ARCORI_RATE_LIMIT_AUTH_IDENTITY_WINDOW_S=900

ARCORI_REFRESH_SESSION_KEY_PREFIX=Arcori:rt:

# Dart container → FastAPI service tier (host dev can omit; defaults to 127.0.0.1:8000)
FASTAPI_SERVICE_URL=http://Arcori_api:8000

PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
SLOW_REQUEST_THRESHOLD_MS=5000
LOG_TRACEBACKS=false

UPLOAD_ROOT=/data/uploads
PUBLIC_MEDIA_BASE_URL=
AVATAR_MAX_UPLOAD_BYTES=2097152
AVATAR_MAX_DIMENSION=512
AVATAR_WEBP_QUALITY=82

MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_ENCRYPT=ssl
MAIL_SMTP_USER=REPLACE_WITH_SMTP_USER
MAIL_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Arcori

ARCORI_EMAIL_VERIFICATION_ENABLED=false
ARCORI_EMAIL_VERIFY_TTL_SECONDS=86400
ARCORI_EMAIL_VERIFY_KEY_PREFIX=Arcori:email_verify:
# App Link / mail base (prod: HTTPS domain that serves /.well-known; not Flutter web for mobile)
ARCORI_PUBLIC_APP_URL=http://127.0.0.1:3002

ARCORI_RATE_LIMIT_GUEST_REGISTER_MAX=5
ARCORI_RATE_LIMIT_GUEST_REGISTER_WINDOW_S=3600
