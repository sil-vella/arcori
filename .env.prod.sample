# Copy to .env.prod on the VPS — production (never commit .env.prod)

ARCORI_ENV=production
ARCORI_ALLOW_DEV_LOGIN=false
APP_DEBUG=0
APP_VERSION=1.0.0

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=604800
SERVICE_KEY=REPLACE_WITH_STRONG_RANDOM

POSTGRES_USER=arcori
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM
POSTGRES_DB=arcori
PG_RBAC_ENABLED=1
POSTGRES_APP_USER=arcori_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_RANDOM_APP
POSTGRES_READONLY_USER=arcori_readonly
POSTGRES_READONLY_PASSWORD=REPLACE_WITH_STRONG_RANDOM_READONLY
# Runtime (app role) and migration (owner) URLs are set in docker-compose.yml.
# Host-side tools over VPN (127.0.0.1:5433):
MIGRATION_DATABASE_URL=postgresql://arcori:REPLACE_WITH_STRONG_RANDOM@127.0.0.1:5433/arcori
READONLY_DATABASE_URL=postgresql://arcori_readonly:REPLACE_WITH_STRONG_RANDOM_READONLY@127.0.0.1:5433/arcori

CORS_ALLOWED_ORIGINS=https://your-domain.example
CADDY_DOMAIN=api.your-domain.example
CADDY_GAME_DOMAIN=game.your-domain.example

# Flutter URLs / web port → .env.dart.defines.prod (see .env.dart.defines.prod.sample)

ARCORI_REDIS_READ_CACHE_ENABLED=false
ARCORI_REDIS_KEY_PREFIX=Arcori:cache:
ARCORI_CACHE_EXAMPLE_TTL=60
REDIS_HOST=Arcori_redis
REDIS_PORT=6379

ARCORI_RATE_LIMIT_ENABLED=true
ARCORI_RATE_LIMIT_KEY_PREFIX=Arcori:ratelimit:
ARCORI_RATE_LIMIT_GLOBAL_MAX=120
ARCORI_RATE_LIMIT_GLOBAL_WINDOW_S=60
ARCORI_RATE_LIMIT_AUTH_MAX=20
ARCORI_RATE_LIMIT_AUTH_WINDOW_S=60
ARCORI_RATE_LIMIT_AUTH_IDENTITY_MAX=10
ARCORI_RATE_LIMIT_AUTH_IDENTITY_WINDOW_S=900

ARCORI_REFRESH_SESSION_KEY_PREFIX=Arcori:rt:

PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
SLOW_REQUEST_THRESHOLD_MS=5000
LOG_TRACEBACKS=false
DUTCH_DEV_LOG=0

UPLOAD_ROOT=/data/uploads
# Arcori catalog art (compose mounts assets/images/arcori → this path, read-only)
CATALOG_MEDIA_ROOT=/data/catalog-media
PUBLIC_MEDIA_BASE_URL=
AVATAR_MAX_UPLOAD_BYTES=2097152
AVATAR_MAX_DIMENSION=512
AVATAR_WEBP_QUALITY=82

MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_ENCRYPT=ssl
MAIL_SMTP_USER=REPLACE_WITH_SMTP_USER
MAIL_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Arcori

ARCORI_EMAIL_VERIFICATION_ENABLED=true
ARCORI_EMAIL_VERIFY_TTL_SECONDS=86400
ARCORI_EMAIL_VERIFY_KEY_PREFIX=Arcori:email_verify:
# App Link / mail base (HTTPS domain that serves /.well-known for Android/iOS)
ARCORI_PUBLIC_APP_URL=https://your-domain.example

ARCORI_RATE_LIMIT_GUEST_REGISTER_MAX=5
ARCORI_RATE_LIMIT_GUEST_REGISTER_WINDOW_S=3600

# Task Manager (dashboard iframe + wfstart label create) — HTTP origin only (no TLS on tm.*)
TASK_MANAGER_BASE_URL=http://tm.reignofplay.com
TASK_MANAGER_SLUG=arcori
# API login (POST /api/login.php → Bearer JWT). Never commit real values.
TM_USERNAME=
TM_PASSWORD=
# Align with Task Manager server JWT_SECRET (ops); not sent on client API calls
TM_JWT_SECRET=

# Marketing local campaigns + Hostinger queue product = REPO_BRAND
# REPO_BRAND=arcori
MARKETING_LOCAL_DIR=
