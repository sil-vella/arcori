# Copy to .env.dart.defines.local — Flutter dart-define SSOT (local, never commit real overrides if sensitive)
# Loaded by wfrun when you run automation/frontend/* with environment "local".
# Physical device: use your Mac LAN IP, not 127.0.0.1 (phone cannot reach host loopback).

ARCORI_API_REST_URL=http://127.0.0.1:8000
ARCORI_API_WS_URL=ws://127.0.0.1:8000/ws/authuser
ARCORI_DART_WS_URL=ws://127.0.0.1:8080/ws/authuser

FLUTTER_WEB_PORT=3002
FLUTTER_WEB_HOSTNAME=localhost

APP_PLATFORM=flutter
BUILD_MODE=debug
DUTCH_DEV_LOG=1
SHOW_INTRO_LOTTIE=0

# Firebase GA4 — Arcori Dev v1 (wf-template-dev-v1)
# API keys: copy from secrets/google-services.json and secrets/GoogleService-Info.plist
# Native configs: cp secrets/google-services.json → app_codebase/flutter_base_06/android/app/
#                 cp secrets/GoogleService-Info.plist → app_codebase/flutter_base_06/ios/Runner/
FIREBASE_SWITCH=false
FIREBASE_APP_ENVIRONMENT=development

FIREBASE_ANDROID_API_KEY=REPLACE_WITH_YOUR_ANDROID_API_KEY
FIREBASE_ANDROID_APP_ID=1:458584350037:android:12f21021079766358423dc
FIREBASE_ANDROID_MESSAGING_SENDER_ID=458584350037
FIREBASE_ANDROID_PROJECT_ID=wf-template-dev-v1
FIREBASE_ANDROID_STORAGE_BUCKET=wf-template-dev-v1.firebasestorage.app

FIREBASE_IOS_API_KEY=REPLACE_WITH_YOUR_IOS_API_KEY
FIREBASE_IOS_APP_ID=1:458584350037:ios:87a3c3c9381671718423dc
FIREBASE_IOS_MESSAGING_SENDER_ID=458584350037
FIREBASE_IOS_PROJECT_ID=wf-template-dev-v1
FIREBASE_IOS_STORAGE_BUCKET=wf-template-dev-v1.firebasestorage.app
FIREBASE_IOS_BUNDLE_ID=com.reignofplay.wf-template
